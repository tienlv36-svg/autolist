# Thu thập tự động 0:00 và 12:00 (đổi giờ: config/settings.yaml -> schedule.cron)
# (crawl -> tag-types -> dedupe -> re-build -> lịch sử giá -> file đính kèm -> sao lưu -> Telegram)
# copy vào /etc/systemd/system/ rồi: sudo systemctl enable --now auction-scheduler
[Unit]
Description=Auction crawler scheduler
After=network-online.target

[Service]
User=auction
WorkingDirectory=/opt/autolist
ExecStart=/opt/autolist/.venv/bin/auction schedule
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
